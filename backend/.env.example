# Copy to .env and fill in real values. .env is gitignored - never commit it.

DATABASE_URL=postgres://boxtrack:boxtrack@localhost:5432/boxtrack
PORT=3000

# Production only - leave empty/unset in local development.
# true when the database is hosted (Render, Railway, Neon...) and requires TLS.
DATABASE_SSL=
# Deployed front-end origin(s), comma-separated. Unset = any origin (dev).
FRONTEND_URL=
# Number of reverse-proxy hops in front of the API (1 on Render/Railway),
# so the login rate limiter sees real client IPs.
TRUST_PROXY=

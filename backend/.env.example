# Copy to .env and fill in real values. .env is gitignored - never commit it.

DATABASE_URL=postgres://boxtrack:boxtrack@localhost:5432/boxtrack
PORT=3000

# Set in production to restrict CORS to the deployed frontend origin only.
# Leave unset in dev to allow any origin.
FRONTEND_URL=

# Free key at https://spoonacular.com/food-api/console#Dashboard - used
# server-side only by the admin recipe search (GET /admin/recipes/search).
SPOONACULAR_API_KEY=
